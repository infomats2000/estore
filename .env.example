DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-string"
JWT_SECRET="replace-with-a-long-random-string"
UPLOAD_PATH="./uploads"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional existing integrations
GEMINI_API_KEY="MY_GEMINI_API_KEY"
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Production object storage (Supabase Storage). Leave unset for local-disk development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=store-erp-assets
TENANT_STORAGE_QUOTA_MB=1024

# Operational controls
SEED_ON_STARTUP=false
LOG_REQUESTS=false
